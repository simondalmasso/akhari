rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'simondalmasso44@gmail.com';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'items', 'total', 'status', 'createdAt', 'customerName', 'note'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000000
        && request.resource.data.status == 'pending'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }
  }
}
