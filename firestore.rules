rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function bootstrapAdmin() {
      return signedInVerified()
        && request.auth.token.email == "simondalmasso44@gmail.com";
    }

    function isAdmin() {
      return bootstrapAdmin()
        || (signedInVerified()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    match /products/{productId} {
      // Public storefront reads only active items; administrators can manage all items.
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get: if settingId == "store";
      allow list: if false;
      allow create, update: if isAdmin()
        && settingId == "store"
        && request.resource.data.keys().hasOnly(["whatsapp", "updatedAt"])
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() <= 24;
      allow delete: if isAdmin() && settingId == "store";
    }

    match /orders/{orderId} {
      // No online payment: this collection stores order requests for manual confirmation.
      allow create: if request.resource.data.keys().hasAll([
          "items", "total", "status", "createdAt", "customerName", "note"
        ])
        && request.resource.data.keys().hasOnly([
          "items", "total", "status", "createdAt", "customerName", "note"
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000000
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      // A signed-in user may check only their own access document.
      allow get: if isAdmin() || (signedInVerified() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /accessRequests/{uid} {
      allow create: if signedInVerified()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          "uid", "email", "displayName", "requestedAt", "status"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == "pending";
      allow get: if isAdmin() || (signedInVerified() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
